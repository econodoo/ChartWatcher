<Window
    x:Class="ChartWatcher.UI.Windows.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:ChartWatcher.UI.Windows"
    xmlns:uc="using:ChartWatcher.UI.Controls">

    <Grid Background="{ThemeResource BackgroundPrimary}">
        <Grid.Resources>
            <!-- Source list item template -->
            <DataTemplate x:Key="SourceItemTemplate">
                <Grid Padding="4,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource StatusDotReady}"
                             VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="SSI iBoard"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource ForegroundPrimary}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Padding="4,2"
                            Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE72C;" FontSize="10"
                                  Foreground="{ThemeResource ForegroundDim}" />
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- Library item template -->
            <DataTemplate x:Key="LibraryItemTemplate">
                <Grid Padding="4,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="12"
                              Foreground="{ThemeResource AccentBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Component"
                               FontSize="{ThemeResource FontSizeCaption}"
                               Foreground="{ThemeResource ForegroundPrimary}"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />     <!-- Toolbar -->
            <RowDefinition Height="*" />         <!-- Main content -->
            <RowDefinition Height="Auto" />     <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Hidden panel: source WebView2 instances (collapsed but active) -->
        <Grid x:Name="HiddenWebViewPanel" Visibility="Collapsed"
              Width="0" Height="0" />

        <!-- ═══ ROW 0: TOOLBAR ═══ -->
        <Grid Grid.Row="0" Background="{ThemeResource ToolbarBackground}"
              Padding="8,4" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />  <!-- Left group -->
                <ColumnDefinition Width="*" />     <!-- Spacer -->
                <ColumnDefinition Width="Auto" />  <!-- Right group -->
            </Grid.ColumnDefinitions>

            <!-- Left toolbar buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <Button x:Name="BtnToggleLeft" Click="BtnToggleLeft_Click"
                        ToolTipService.ToolTip="Toggle Explorer"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,6">
                    <FontIcon Glyph="&#xE700;" FontSize="14"
                              Foreground="{ThemeResource ForegroundSecondary}" />
                </Button>

                <AppBarSeparator />

                <Button x:Name="BtnAddSource" Click="BtnAddSource_Click"
                        ToolTipService.ToolTip="Add Source"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12"
                                  Foreground="{ThemeResource ForegroundSecondary}" />
                        <TextBlock Text="Source" FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource ForegroundSecondary}" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnAddComponent" Click="BtnAddComponent_Click"
                        ToolTipService.ToolTip="Add Component"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12"
                                  Foreground="{ThemeResource ForegroundSecondary}" />
                        <TextBlock Text="Component" FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource ForegroundSecondary}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right toolbar buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="BtnDesignMode" Click="BtnDesignMode_Click"
                              IsChecked="True"
                              ToolTipService.ToolTip="Toggle Design / View Mode"
                              Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontSize="12"
                                  Foreground="{ThemeResource ForegroundSecondary}" />
                        <TextBlock x:Name="TxtDesignMode" Text="Design"
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource ForegroundSecondary}" />
                    </StackPanel>
                </ToggleButton>

                <AppBarSeparator />

                <controls:DropDownButton ToolTipService.ToolTip="Switch Theme"
                                          Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE790;" FontSize="12"
                                  Foreground="{ThemeResource ForegroundSecondary}" />
                        <TextBlock x:Name="TxtCurrentTheme" Text="Colorful"
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource ForegroundSecondary}" />
                    </StackPanel>
                    <controls:DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Colorful" Click="ThemeColorful_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE790;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Stealth" Click="ThemeStealth_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEA80;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Color-Blind Safe" Click="ThemeColorBlind_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </controls:DropDownButton.Flyout>
                </controls:DropDownButton>

                <AppBarSeparator />

                <Button x:Name="BtnToggleRight" Click="BtnToggleRight_Click"
                        ToolTipService.ToolTip="Toggle Inspector"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Padding="8,6">
                    <FontIcon Glyph="&#xE946;" FontSize="14"
                              Foreground="{ThemeResource ForegroundSecondary}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ ROW 1: MAIN CONTENT (3 columns) ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="240" MinWidth="0" />
                <ColumnDefinition Width="Auto" />  <!-- Splitter -->
                <ColumnDefinition Width="*" />      <!-- Center -->
                <ColumnDefinition Width="Auto" />  <!-- Splitter -->
                <ColumnDefinition x:Name="ColRight" Width="280" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Explorer -->
            <Grid x:Name="PanelLeft" Grid.Column="0"
                  Background="{ThemeResource BackgroundSecondary}"
                  BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0"
                  Padding="{ThemeResource PanelPadding}">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <!-- Sources section -->
                        <controls:Expander IsExpanded="True" HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Stretch"
                                           ExpandDirection="Down">
                            <controls:Expander.Header>
                                <TextBlock Text="SOURCES"
                                           FontSize="{ThemeResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource ForegroundDim}"
                                           CharacterSpacing="80" />
                            </controls:Expander.Header>
                            <controls:Expander.Content>
                                <StackPanel Spacing="4">
                                    <controls:ItemsRepeater x:Name="SourcesList"
                                                             ItemTemplate="{StaticResource SourceItemTemplate}" />
                                    <HyperlinkButton Content="+ Add source" Click="BtnAddSource_Click"
                                                     Foreground="{ThemeResource AccentBrush}"
                                                     FontSize="{ThemeResource FontSizeCaption}" />
                                </StackPanel>
                            </controls:Expander.Content>
                        </controls:Expander>

                        <!-- Component Library section -->
                        <controls:Expander IsExpanded="True" HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Stretch"
                                           ExpandDirection="Down">
                            <controls:Expander.Header>
                                <TextBlock Text="LIBRARY"
                                           FontSize="{ThemeResource FontSizeCaption}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource ForegroundDim}"
                                           CharacterSpacing="80" />
                            </controls:Expander.Header>
                            <controls:Expander.Content>
                                <StackPanel Spacing="4">
                                    <controls:ItemsRepeater x:Name="LibraryList"
                                                             ItemTemplate="{StaticResource LibraryItemTemplate}" />
                                    <TextBlock Text="Pick elements from a source to build components."
                                               TextWrapping="Wrap"
                                               FontSize="{ThemeResource FontSizeCaption}"
                                               Foreground="{ThemeResource ForegroundDim}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </controls:Expander.Content>
                        </controls:Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Left splitter -->
            <Grid Grid.Column="1" Width="4" Background="Transparent"
                  PointerPressed="LeftSplitter_PointerPressed"
                  PointerMoved="LeftSplitter_PointerMoved"
                  PointerReleased="Splitter_PointerReleased"
                  PointerEntered="Splitter_PointerEntered">
                <Rectangle Width="1" Fill="{ThemeResource BorderBrush}"
                           HorizontalAlignment="Center" />
            </Grid>

            <!-- CENTER: TabView + Grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tab strip -->
                <controls:TabView x:Name="DashboardTabs"
                                  Grid.Row="0"
                                  IsAddTabButtonVisible="True"
                                  AddTabButtonClick="DashboardTabs_AddTabClick"
                                  TabCloseRequested="DashboardTabs_TabCloseRequested"
                                  SelectionChanged="DashboardTabs_SelectionChanged"
                                  Background="{ThemeResource TabBackground}"
                                  TabWidthMode="SizeToContent"
                                  CloseButtonOverlayMode="OnPointerOver"
                                  CanReorderTabs="True"
                                  CanDragTabs="True">
                    <controls:TabView.TabStripHeader>
                        <Grid Padding="8,0" />
                    </controls:TabView.TabStripHeader>
                </controls:TabView>

                <!-- Dashboard grid canvas -->
                <Grid x:Name="DashboardCanvas" Grid.Row="1"
                      Background="{ThemeResource BackgroundPrimary}"
                      Padding="8">
                    <!-- Grid lines rendered in code-behind -->
                    <Canvas x:Name="GridLinesCanvas" Opacity="0.15" />
                    <!-- Component cards placed here -->
                    <Canvas x:Name="ComponentCanvas" />
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="Visible">
                        <FontIcon Glyph="&#xE8A5;" FontSize="48"
                                  Foreground="{ThemeResource ForegroundDim}"
                                  HorizontalAlignment="Center" />
                        <TextBlock Text="No components on this tab"
                                   FontSize="{ThemeResource FontSizeSubtitle}"
                                   Foreground="{ThemeResource ForegroundDim}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add a source, then pick elements to watch."
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   Foreground="{ThemeResource ForegroundDim}"
                                   HorizontalAlignment="Center" />
                        <Button Content="Add your first source"
                                Click="BtnAddSource_Click"
                                HorizontalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right splitter -->
            <Grid Grid.Column="3" Width="4" Background="Transparent"
                  PointerPressed="RightSplitter_PointerPressed"
                  PointerMoved="RightSplitter_PointerMoved"
                  PointerReleased="Splitter_PointerReleased"
                  PointerEntered="Splitter_PointerEntered">
                <Rectangle Width="1" Fill="{ThemeResource BorderBrush}"
                           HorizontalAlignment="Center" />
            </Grid>

            <!-- RIGHT PANEL: Inspector -->
            <Grid x:Name="PanelRight" Grid.Column="4"
                  Background="{ThemeResource BackgroundSecondary}"
                  BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0"
                  Padding="{ThemeResource PanelPadding}">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="INSPECTOR"
                                   FontSize="{ThemeResource FontSizeCaption}"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource ForegroundDim}"
                                   CharacterSpacing="80"
                                   Margin="4,8,0,0" />

                        <!-- No selection state -->
                        <StackPanel x:Name="InspectorEmpty" Spacing="8" Margin="4">
                            <FontIcon Glyph="&#xE946;" FontSize="32"
                                      Foreground="{ThemeResource ForegroundDim}"
                                      HorizontalAlignment="Center" />
                            <TextBlock Text="Select a component to inspect its properties."
                                       TextWrapping="Wrap"
                                       FontSize="{ThemeResource FontSizeCaption}"
                                       Foreground="{ThemeResource ForegroundDim}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                        </StackPanel>

                        <!-- Inspector sections (shown when component selected) -->
                        <StackPanel x:Name="InspectorContent" Spacing="12" Visibility="Collapsed">
                            <!-- Identity -->
                            <controls:Expander IsExpanded="True" HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch">
                                <controls:Expander.Header>
                                    <TextBlock Text="Identity" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ForegroundPrimary}" />
                                </controls:Expander.Header>
                                <controls:Expander.Content>
                                    <StackPanel Spacing="8">
                                        <TextBox x:Name="TxtComponentTitle"
                                                 Header="Title" PlaceholderText="Component name" />
                                    </StackPanel>
                                </controls:Expander.Content>
                            </controls:Expander>

                            <!-- Layout -->
                            <controls:Expander IsExpanded="True" HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch">
                                <controls:Expander.Header>
                                    <TextBlock Text="Layout" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ForegroundPrimary}" />
                                </controls:Expander.Header>
                                <controls:Expander.Content>
                                    <Grid ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <controls:NumberBox x:Name="NbRow" Header="Row"
                                                            Minimum="0" Maximum="7"
                                                            SpinButtonPlacementMode="Compact"
                                                            ValueChanged="LayoutChanged" />
                                        <controls:NumberBox x:Name="NbCol" Header="Col"
                                                            Grid.Column="1"
                                                            Minimum="0" Maximum="11"
                                                            SpinButtonPlacementMode="Compact"
                                                            ValueChanged="LayoutChanged" />
                                        <controls:NumberBox x:Name="NbRowSpan" Header="Row Span"
                                                            Grid.Row="1"
                                                            Minimum="1" Maximum="8"
                                                            SpinButtonPlacementMode="Compact"
                                                            ValueChanged="LayoutChanged" />
                                        <controls:NumberBox x:Name="NbColSpan" Header="Col Span"
                                                            Grid.Row="1" Grid.Column="1"
                                                            Minimum="1" Maximum="12"
                                                            SpinButtonPlacementMode="Compact"
                                                            ValueChanged="LayoutChanged" />
                                    </Grid>
                                </controls:Expander.Content>
                            </controls:Expander>

                            <!-- Source info -->
                            <controls:Expander IsExpanded="False" HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch">
                                <controls:Expander.Header>
                                    <TextBlock Text="Source" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ForegroundPrimary}" />
                                </controls:Expander.Header>
                                <controls:Expander.Content>
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="TxtSourceName" Text="—"
                                                   Foreground="{ThemeResource ForegroundSecondary}" />
                                        <TextBlock x:Name="TxtRenderMode" Text="—"
                                                   FontSize="{ThemeResource FontSizeCaption}"
                                                   Foreground="{ThemeResource ForegroundDim}" />
                                    </StackPanel>
                                </controls:Expander.Content>
                            </controls:Expander>

                            <!-- Diagnostics -->
                            <controls:Expander IsExpanded="False" HorizontalAlignment="Stretch"
                                               HorizontalContentAlignment="Stretch">
                                <controls:Expander.Header>
                                    <TextBlock Text="Diagnostics" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ForegroundPrimary}" />
                                </controls:Expander.Header>
                                <controls:Expander.Content>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="TxtLastUpdate" Text="Last update: —"
                                                   FontSize="{ThemeResource FontSizeCaption}"
                                                   Foreground="{ThemeResource ForegroundDim}" />
                                    </StackPanel>
                                </controls:Expander.Content>
                            </controls:Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ═══ ROW 2: STATUS BAR ═══ -->
        <Grid Grid.Row="2" Background="{ThemeResource StatusBarBackground}"
              Padding="12,4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Source status dots -->
            <StackPanel x:Name="StatusDots" Grid.Column="0"
                        Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" />

            <!-- Last update -->
            <TextBlock x:Name="TxtLastMutation" Grid.Column="1"
                       Text="—"
                       FontSize="{ThemeResource FontSizeCaption}"
                       Foreground="{ThemeResource ForegroundDim}"
                       VerticalAlignment="Center" />

            <!-- Spacer -->
            <TextBlock Grid.Column="2" />

            <!-- Memory -->
            <TextBlock x:Name="TxtMemory" Grid.Column="3"
                       Text="— MB"
                       FontSize="{ThemeResource FontSizeCaption}"
                       Foreground="{ThemeResource ForegroundDim}"
                       VerticalAlignment="Center" />

            <!-- Mode badge -->
            <Border Grid.Column="4"
                    Background="{ThemeResource BackgroundDim}"
                    CornerRadius="{ThemeResource ButtonCornerRadius}"
                    Padding="8,2">
                <TextBlock x:Name="TxtModeBadge" Text="Design"
                           FontSize="{ThemeResource FontSizeCaption}"
                           Foreground="{ThemeResource AccentBrush}"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>

</Window>
