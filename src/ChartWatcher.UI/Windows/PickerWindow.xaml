<Window
    x:Class="ChartWatcher.UI.Windows.PickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Pick Element">

    <Grid Background="{ThemeResource BackgroundPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Toolbar -->
            <RowDefinition Height="*" />      <!-- WebView2 -->
            <RowDefinition Height="Auto" />  <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource ToolbarBackground}"
              Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{ThemeResource ForegroundSecondary}">
                <Run Text="Source: " />
                <Run x:Name="TxtSourceName" Text="—" FontWeight="SemiBold"
                     Foreground="{ThemeResource ForegroundPrimary}" />
            </TextBlock>

            <!-- Spacer -->
            <TextBlock Grid.Column="1" />

            <Button x:Name="BtnCancelPick" Grid.Column="2"
                    Content="Cancel" Click="BtnCancel_Click" />
            <Button x:Name="BtnDonePick" Grid.Column="3"
                    Content="Done" Style="{ThemeResource AccentButtonStyle}"
                    Click="BtnDone_Click" IsEnabled="False" />
        </Grid>

        <!-- WebView2 container -->
        <Grid x:Name="WebViewContainer" Grid.Row="1" />

        <!-- Status / picked element info -->
        <Grid Grid.Row="2" Background="{ThemeResource StatusBarBackground}"
              Padding="12,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StatusDot" Grid.Column="0"
                     Width="8" Height="8" Fill="{ThemeResource StatusDotLoading}"
                     VerticalAlignment="Center" />

            <TextBlock x:Name="TxtPickStatus" Grid.Column="1"
                       Text="Loading source page..."
                       FontSize="12"
                       Foreground="{ThemeResource ForegroundSecondary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock x:Name="TxtPickedCount" Grid.Column="2"
                       Text="0 picked"
                       FontSize="11"
                       Foreground="{ThemeResource ForegroundDim}"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
