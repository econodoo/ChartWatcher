<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Market direction -->
    <SolidColorBrush x:Key="UpBrush" Color="#FF00C853" />
    <SolidColorBrush x:Key="DownBrush" Color="#FFFF1744" />
    <SolidColorBrush x:Key="FlatBrush" Color="#FFFFAB00" />

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#FF1A1A2E" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#FF16213E" />
    <SolidColorBrush x:Key="BackgroundDim" Color="#FF0F3460" />
    <SolidColorBrush x:Key="BackgroundCard" Color="#FF1E2A4A" />
    <SolidColorBrush x:Key="BackgroundCardHover" Color="#FF253560" />

    <!-- Foregrounds -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#FFB0BEC5" />
    <SolidColorBrush x:Key="ForegroundDim" Color="#FF607D8B" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF536DFE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF7C8EFF" />
    <SolidColorBrush x:Key="AlertBrush" Color="#FFFF6D00" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF2C3E6B" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="#FF536DFE" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FF0D1025" />
    <SolidColorBrush x:Key="StatusDotReady" Color="#FF00E676" />
    <SolidColorBrush x:Key="StatusDotLoading" Color="#FFFFAB00" />
    <SolidColorBrush x:Key="StatusDotError" Color="#FFFF1744" />

    <!-- Tab strip -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF16213E" />
    <SolidColorBrush x:Key="TabActiveBackground" Color="#FF1E2A4A" />

    <!-- Toolbar -->
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FF111328" />

    <!-- Typography -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="PanelPadding">8</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>

    <!-- Theme name (for identification) -->
    <x:String x:Key="ThemeName">Colorful</x:String>

    <!-- Subtle button style: transparent bg, dim hover -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>
