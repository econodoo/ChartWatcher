<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Market direction — muted -->
    <SolidColorBrush x:Key="UpBrush" Color="#FF26A69A" />
    <SolidColorBrush x:Key="DownBrush" Color="#FFEF9A9A" />
    <SolidColorBrush x:Key="FlatBrush" Color="#FFFFCC80" />

    <!-- Backgrounds — dark, minimal contrast -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#FF212121" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="BackgroundDim" Color="#FF383838" />
    <SolidColorBrush x:Key="BackgroundCard" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="BackgroundCardHover" Color="#FF3A3A3A" />

    <!-- Foregrounds — soft -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#FFCECECE" />
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#FF9E9E9E" />
    <SolidColorBrush x:Key="ForegroundDim" Color="#FF707070" />

    <!-- Accents — amber, understated -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFB74D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFD54F" />
    <SolidColorBrush x:Key="AlertBrush" Color="#FFFF8A65" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF424242" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="#FFFFB74D" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="StatusDotReady" Color="#FF26A69A" />
    <SolidColorBrush x:Key="StatusDotLoading" Color="#FFFFCC80" />
    <SolidColorBrush x:Key="StatusDotError" Color="#FFEF9A9A" />

    <!-- Tab strip -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="TabActiveBackground" Color="#FF383838" />

    <!-- Toolbar -->
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FF1A1A1A" />

    <!-- Typography -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="PanelPadding">8</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>

    <x:String x:Key="ThemeName">Stealth</x:String>

    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>
