<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Market direction — IBM accessible: blue=up, orange=down -->
    <SolidColorBrush x:Key="UpBrush" Color="#FF648FFF" />
    <SolidColorBrush x:Key="DownBrush" Color="#FFFE6100" />
    <SolidColorBrush x:Key="FlatBrush" Color="#FFDC267F" />

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#FF1B1B2F" />
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#FF252545" />
    <SolidColorBrush x:Key="BackgroundDim" Color="#FF303060" />
    <SolidColorBrush x:Key="BackgroundCard" Color="#FF222244" />
    <SolidColorBrush x:Key="BackgroundCardHover" Color="#FF2A2A55" />

    <!-- Foregrounds — high contrast -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#FFD0D0E0" />
    <SolidColorBrush x:Key="ForegroundDim" Color="#FF8888AA" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF785EF0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF9A82FF" />
    <SolidColorBrush x:Key="AlertBrush" Color="#FFFFB000" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3A3A66" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="#FF785EF0" />

    <!-- Status bar -->
    <SolidColorBrush x:Key="StatusBarBackground" Color="#FF121222" />
    <SolidColorBrush x:Key="StatusDotReady" Color="#FF648FFF" />
    <SolidColorBrush x:Key="StatusDotLoading" Color="#FFFFB000" />
    <SolidColorBrush x:Key="StatusDotError" Color="#FFFE6100" />

    <!-- Tab strip -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF252545" />
    <SolidColorBrush x:Key="TabActiveBackground" Color="#FF303060" />

    <!-- Toolbar -->
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FF121222" />

    <!-- Typography -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeDisplay">28</x:Double>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="PanelPadding">8</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>

    <x:String x:Key="ThemeName">ColorBlind</x:String>

    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

</ResourceDictionary>
